# Local development: next dev starts the app; Docker provides Postgres + Mailpit.
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
# DATABASE_URL=postgres://crm:crm_local@127.0.0.1:5432/crm
# POSTGRES_PORT=5432

# Development generates a persistent random secret in backend/data/auth-secret.
# Set a unique secret (at least 32 characters) for production, plus DATABASE_URL,
# HTTPS BETTER_AUTH_URL, SMTP_HOST and EMAIL_FROM. Never commit secrets.
# BETTER_AUTH_SECRET=

# No SMTP configuration needed locally: Mailpit catches messages, UI on port 8025.
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=CRM <login@crm.local>

# Optional AI generation (server-only), independent of account authentication.
AI_BASE_URL=http://localhost:1234/v1
AI_MODEL=qwen/qwen3.8-27b
# AI_API_KEY=
# AI_ENABLED=false

# Production deployment (Vercel + Supabase — single platform, no separate backend)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# BETTER_AUTH_URL=https://your-app.vercel.app
# BETTER_AUTH_SECRET=<random-48+-char-string>
# NODE_ENV=production
