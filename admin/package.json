{
  "name": "crm-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.8",
  "engines": {
    "bun": ">=1.3.8",
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "bun tools/dev/run.ts",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "dev:frontend": "bun tools/dev/run.ts --frontend-only",
    "dev:backend": "bun --watch backend/server.ts",
    "db:init": "bun backend/db.ts",
    "test:data": "bun test backend/tests",
    "test:chat": "bun test tools/chat",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p backend/tsconfig.json",
    "test:dev": "bun test tools/dev/run.test.ts",
    "test": "bun test",
    "package:release": "bun tools/release/package.ts",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@ai-sdk/react": "^4.0.102",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/react": "^0.5.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.2.4",
    "ai": "^7.0.99",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@shadcn/helpers": "^0.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "20.14.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
