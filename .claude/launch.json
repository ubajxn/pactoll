{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ptp-deck",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "3456", "."],
      "port": 3456
    },
    {
      "name": "ptp-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3457"],
