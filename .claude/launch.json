{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ptp-deck",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "3456", "."],
      "port": 3456
    },
    {
      "name": "ptp-admin",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd admin && npm run dev -- -p 3460"],
      "port": 3460,
      "url": "http://localhost:3460"
    },
    {
      "name": "ptp-website",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "3458", "--directory", "site"],
      "port": 3458
    }
  ]
}
